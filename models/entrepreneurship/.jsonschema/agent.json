{
  "$defs": {
    "distribution": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "dist": {
          "enum": [
            "uniform",
            "normal",
            "bernoulli",
            "choice"
          ]
        },
        "max": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "type": "number"
        },
        "values": {
          "type": "array"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "dist"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
