              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            }
          },
          "type": "object"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "enum": [
                  "owns"
                ]
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "const": "firm"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "knowledge": {
              "anyOf": [
                {
                  "description": "Business knowledge; raises the chance a venture works",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "riskTolerance": {
              "anyOf": [
                {
