{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "businessCost": {
      "description": "Capital needed to open a firm",
      "type": "integer"
    },
    "demand": {
      "description": "Aggregate demand index; 1 is normal",
      "maximum": 2,
      "minimum": 0.2,
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "interestRate": {
      "description": "Base interest rate (yearly), set by the central bank",
      "maximum": 0.5,
      "minimum": 0,
      "type": "number"
    },
    "wage": {
      "description": "Income per tick of working",
      "type": "integer"
    }
  },
  "title": "entrepreneurship context file",
  "type": "object"
}
