{
  "$defs": {
    "distribution": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "dist": {
          "enum": [
            "uniform",
            "normal",
            "bernoulli",
            "choice"
          ]
        },
        "max": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "type": "number"
        },
        "values": {
          "type": "array"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "dist"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "A person. A consumer while owning no land, a producer while owning at least one plot. Everyone tries to eat a full ration every day and saves or invests what is left.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "age": {
              "anyOf": [
                {
                  "description": "Age in days",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "ambition": {
              "anyOf": [
                {
                  "description": "Drive to own and expand a business",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "askPrice": {
              "anyOf": [
                {
                  "description": "Price the producer posts per bread",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "ateToday": {
              "anyOf": [
                {
                  "description": "Bread eaten today",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "bidLimit": {
              "anyOf": [
                {
                  "description": "Most this person pays for a bread; rises after hungry days, eases after full ones",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "daysWithoutFood": {
              "anyOf": [
                {
                  "description": "Consecutive days without any bread",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "dead": {
              "anyOf": [
                {
                  "description": "Died today; the funerals rule removes the person and passes the plots on",
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "hunger": {
              "anyOf": [
                {
                  "description": "0 after a full ration; unchanged when one bread short, +1 when two short, +hungerPerDay when three or more short. Above maxHunger the person dies",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "income": {
              "anyOf": [
                {
                  "description": "Wage and profit received today",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "lands": {
              "anyOf": [
                {
                  "description": "Plots owned; 0 means consumer",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "offered": {
              "anyOf": [
                {
                  "description": "Bread put on sale today, after the producer ate its own share",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "riskTolerance": {
              "anyOf": [
                {
                  "description": "Willingness to put savings at risk",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "spent": {
              "anyOf": [
                {
                  "description": "Money spent today on bread and land",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "stock": {
              "anyOf": [
                {
                  "description": "Bread baked today and not yet sold",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "wealth": {
              "anyOf": [
                {
                  "description": "Savings",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            }
          },
          "type": "object"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "enum": [
                  "parent"
                ]
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "const": "islander"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "bread-island agent file"
}
