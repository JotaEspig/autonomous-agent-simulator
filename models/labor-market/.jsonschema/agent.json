{
  "$defs": {
    "distribution": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "dist": {
          "enum": [
            "uniform",
            "normal",
            "bernoulli",
            "choice"
          ]
        },
        "max": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "type": "number"
        },
        "values": {
          "type": "array"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "dist"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "A firm of the sector. Wants to grow its profit by employing capable workers; knows the true capacity of its own staff and reads candidates through interviews.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "age": {
              "anyOf": [
                {
                  "description": "Months in business",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "capacitySum": {
              "anyOf": [
                {
                  "description": "Total capacity of the staff: output per month",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "cash": {
              "anyOf": [
                {
                  "description": "Money in the bank; below what the payroll needs, the firm goes bankrupt",
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "headcount": {
              "anyOf": [
                {
                  "description": "People employed",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "horizon": {
              "anyOf": [
                {
                  "description": "Months ahead the firm weighs when choosing whom to hire: long horizons invest in people who will grow. It changes with experience: juniors promoted at the firm lengthen it, juniors who leave early shorten it",
                  "minimum": 1,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "layoffsPlanned": {
              "anyOf": [
                {
                  "description": "People the firm decided to lay off this month",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "margin": {
              "anyOf": [
                {
                  "description": "Profit over revenue last month",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "markdown": {
              "anyOf": [
                {
                  "description": "Share of a candidate's estimated value the firm tries to keep when making an offer",
                  "maximum": 0.9,
                  "minimum": 0.02,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "openings": {
              "anyOf": [
                {
                  "description": "Jobs the firm is recruiting for this month",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "patience": {
              "anyOf": [
                {
                  "description": "How far below their wage a person's value may fall before the firm considers a layoff. Each firm has its own",
                  "maximum": 0.9,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "revenue": {
              "anyOf": [
                {
                  "description": "Revenue last month",
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "share": {
              "anyOf": [
                {
                  "description": "Share of the sector's output",
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "tolerance": {
              "anyOf": [
                {
                  "description": "Patience left this month: the firm's patience, shrinking with losses",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "underwater": {
              "anyOf": [
                {
                  "description": "Staff whose value to the firm is more than tolerance below their wage",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "wageBill": {
              "anyOf": [
                {
                  "description": "Wages paid last month",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            }
          },
          "type": "object"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "enum": [
                  "owns"
                ]
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "const": "firm"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A person in the labor market. Must pay the cost of living every month; wants the highest pay it can get; knows its level and experience, not its exact capacity.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "age": {
              "anyOf": [
                {
                  "description": "Age in months (on the CV)",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "bestOffer": {
              "anyOf": [
                {
                  "description": "Best offer received last month while unemployed; 0 when none",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "capacity": {
              "anyOf": [
                {
                  "description": "Output per month. Grows with work toward talent, decays while unemployed. Only the employer observes it",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "courage": {
              "anyOf": [
                {
                  "description": "Willingness to put savings at risk: drives founding and buying firms",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "employer": {
              "anyOf": [
                {
                  "description": "Id of the employing firm; 0 when unemployed",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "expectedWage": {
              "anyOf": [
                {
                  "description": "What the person believes it can earn: the wage of its job, or for the unemployed the last wage revised toward the offers received",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "experience": {
              "anyOf": [
                {
                  "description": "Months worked in total (shown on the CV)",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "hiredAt": {
              "anyOf": [
                {
                  "description": "Tick at which the person joined its current firm",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "hiredJunior": {
              "anyOf": [
                {
                  "description": "Joined its current firm as a junior: the firm's investment",
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "income": {
              "anyOf": [
                {
                  "description": "Draw (pro-labore) and dividends received this month (owners)",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "incomeAvg": {
              "anyOf": [
                {
                  "description": "Draw and dividends per month, smoothed over about a year: an owner's income for the census",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "investmentLost": {
              "anyOf": [
                {
                  "description": "Firm the person left (poached, quit or laid off) within investmentPayback months of joining it as a junior: an investment that did not pay off, for the firm to learn from; 0 when none",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "lastWage": {
              "anyOf": [
                {
                  "description": "Wage of the last job",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "level": {
              "anyOf": [
                {
                  "description": "Title given by employers; never goes down",
                  "enum": [
                    "junior",
                    "pleno",
                    "senior"
                  ],
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "monthsShort": {
              "anyOf": [
                {
                  "description": "Months in a row unable to pay the cost of living",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "monthsUnemployed": {
              "anyOf": [
                {
                  "description": "Months in a row without a job",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "owner": {
              "anyOf": [
                {
                  "description": "Owns a firm: lives on its draw and dividends, does not work, and does not retire",
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "paidOff": {
              "anyOf": [
                {
                  "description": "Firm whose junior investment just paid off (the person was promoted there), for the firm to learn from; 0 when none",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "reservation": {
              "anyOf": [
                {
                  "description": "Lowest wage accepted this month",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "satisfaction": {
              "anyOf": [
                {
                  "description": "Job satisfaction (0 to 1): how valued the person feels at work, from its pay against its peers', raises and promotions. Low satisfaction makes it look for another job, and at worst quit",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "savings": {
              "anyOf": [
                {
                  "description": "Money saved",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "talent": {
              "anyOf": [
                {
                  "description": "Capacity a lifetime of work approaches",
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "timePreference": {
              "anyOf": [
                {
                  "description": "Time preference (0 to 1): how much the person values the present over the future (Mises). Present-minded people save less, spend their savings faster and settle for a job sooner. It changes with experience: hardship lowers it, long comfort raises it. Hunger raises it for the moment (see search.lua)",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "wage": {
              "anyOf": [
                {
                  "description": "Monthly wage; 0 when unemployed",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            }
          },
          "type": "object"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "enum": [
                  "owns"
                ]
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "const": "worker"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "labor-market agent file"
}
